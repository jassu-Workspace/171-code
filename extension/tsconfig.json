{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOMIterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveExtensions": [
      ".ts",
      ".tsx"
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "wxt.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}